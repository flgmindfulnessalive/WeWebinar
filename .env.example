# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mux (video upload + playback)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Mux Data environment key (client-side playback analytics for MuxPlayer;
# from Mux dashboard -> Settings -> Environments). Safe to expose to the browser.
NEXT_PUBLIC_MUX_DATA_ENV_KEY=

# Stripe (platform subscription: host -> platform)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CORE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cron (protects /api/cron/send-reminders — call it with
# `Authorization: Bearer <CRON_SECRET>` on a schedule, e.g. every 5 min
# via Vercel Cron or Supabase pg_cron)
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
