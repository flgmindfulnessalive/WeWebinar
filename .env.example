# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Video: hosted as unlisted YouTube videos, pasted as a link in the
# webinar wizard — no API keys or third-party account needed here.

# Lemon Squeezy (platform subscription: host -> platform)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID_CORE=
LEMONSQUEEZY_VARIANT_ID_PRO=
LEMONSQUEEZY_VARIANT_ID_BUSINESS=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Anthropic (optional: AI auto-replies in the live chat, toggled per
# webinar in the wizard — defaults to off, safe to leave empty)
ANTHROPIC_API_KEY=

# Vercel Domains API (Business/Enterprise custom domain — Configuración >
# Dominio propio). Token needs the "Manage domains" scope on this project;
# VERCEL_TEAM_ID only if the project lives under a team. Safe to leave
# empty: the settings page still saves the domain, it just can't register
# it with Vercel or verify DNS until these are set.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Cron (protects /api/cron/send-reminders — call it with
# `Authorization: Bearer <CRON_SECRET>` on a schedule, e.g. every 5 min
# via Vercel Cron or Supabase pg_cron)
CRON_SECRET=

# Cloudflare Turnstile (bot protection on /signup). Site key only -- it's
# public, safe to expose client-side. The matching secret key is NOT used
# by this app at all: it's entered directly in the Supabase dashboard
# (Authentication -> Attack Protection -> Enable Captcha protection ->
# Turnstile), since Supabase Auth verifies the token server-side on our
# behalf when we pass it as `captchaToken` to signUp(). Safe to leave
# empty: signUpWithPassword only sends a token when this is set, so
# leaving it blank just means no captcha widget renders (and Supabase's
# own captcha check, once turned on there, will then reject every signup
# -- keep this and the dashboard toggle in sync).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
