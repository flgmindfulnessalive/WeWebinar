# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Video: hosted as unlisted YouTube videos, pasted as a link in the
# webinar wizard — no API keys or third-party account needed here.

# Stripe (platform subscription: host -> platform)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CORE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Anthropic (optional: AI auto-replies in the live chat, toggled per
# webinar in the wizard — defaults to off, safe to leave empty)
ANTHROPIC_API_KEY=

# Cron (protects /api/cron/send-reminders — call it with
# `Authorization: Bearer <CRON_SECRET>` on a schedule, e.g. every 5 min
# via Vercel Cron or Supabase pg_cron)
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
